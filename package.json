{
  "name": "yabudu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "fmt": "biome format --write",
    "ci": "pnpm lint && pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:integration:local": "bash scripts/test-integration.sh",
    "test:e2e": "playwright test",
    "test:e2e:local": "bash scripts/e2e.sh run",
    "test:e2e:headed": "bash scripts/e2e.sh run --headed",
    "e2e:up": "bash scripts/e2e.sh up",
    "e2e:down": "bash scripts/e2e.sh down",
    "e2e:report": "bash scripts/e2e.sh report",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@budu/api-client": "workspace:*",
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@schedule-x/calendar": "^4.7.0",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.7.0",
    "@sentry/nextjs": "10.72.0",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.14.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "temporal-polyfill": "^0.3.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.62.1",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
