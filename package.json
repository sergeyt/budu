{
  "name": "yabudu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "fmt": "biome format --write",
    "ci": "pnpm lint && pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:integration:local": "bash scripts/test-integration.sh",
    "test:e2e": "playwright test",
    "test:e2e:local": "bash scripts/test-e2e.sh",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@budu/api-client": "workspace:*",
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@schedule-x/calendar": "^4.6.1",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.6.1",
    "@sentry/nextjs": "10.70.0",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "temporal-polyfill": "^0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "^1.62.1",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
